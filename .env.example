# ==============================================================================
# AgentPay-x402: Production Solana HTTP 402 Gateway Configuration
# ==============================================================================

# Solana RPC Endpoint (Devnet default or dedicated provider like QuickNode / Helius)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Merchant receiving Solana public key (Base58)
# If left blank, server automatically loads or generates merchant_keypair.json
MERCHANT_PUBLIC_KEY=

# Local merchant keypair path
MERCHANT_KEYPAIR_PATH=merchant_keypair.json

# Target network identification
SOLANA_NETWORK=solana-devnet

# Confirmation commitment ('confirmed' or 'finalized')
SOLANA_COMMITMENT=confirmed

# Replay cache time-to-live in seconds (default: 86400 / 24 hours)
REPLAY_CACHE_TTL_SECONDS=86400

# Server Binding
HOST=127.0.0.1
PORT=8000

# Fallback simulation mode when public Devnet faucets are rate-limited
MOCK_SETTLEMENT=true

# Alpaca Paper Trading Configuration
ALPACA_API_KEY=PKV6FTKSBFEBUW45T4ME6AVBBE
ALPACA_SECRET_KEY=AxTbThigrfmXChC7H1ywTEgQehvvwR7fy1z3LfP4VhWgv
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Nebius Token Factory Configuration
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
NEBIUS_FALLBACK_MODEL=nvidia/Nemotron-3_5-Lightning
